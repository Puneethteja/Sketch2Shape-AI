# Tencent TokenHub configuration. Copy this file to .env and set the key.
TENCENT_TOKENHUB_API_KEY=
HUNYUAN3D_MODEL=hi3d-3.0
HUNYUAN3D_FACE_COUNT=100000

# Meshy Image-to-3D configuration. Set MESHY_API_KEY and choose provider=meshy
# with .\scripts\configure_meshy.ps1 to use Meshy instead.
MESHY_API_KEY=
MESHY_AI_MODEL=meshy-7.1

SKETCH2SHAPE_PROVIDER=local
